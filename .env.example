# Optional. Injected by Strands Box from the host into egress only.
# Never placed in [agent.env]. Lab tests assert it is absent from guarded_env().
GITHUB_TOKEN=

# Non-secret CI / local cargo env (documented for parity with GitHub Actions).
CARGO_TERM_COLOR=always
RUSTFLAGS=-C debuginfo=0

# Telemetry opt-outs used by this lab and strands-box-telemetry demos.
OTEL_SDK_DISABLED=true
OTEL_TRACES_EXPORTER=none
OTEL_METRICS_EXPORTER=none
OTEL_LOGS_EXPORTER=none
