#!/usr/bin/env bash
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"

UPSTREAM_PIN="223e3959d539110eaacfacb6f973c03928dc39b0"
got="$(git -C upstream rev-parse HEAD)"
if [[ "$got" != "$UPSTREAM_PIN" ]]; then
  echo "upstream SHA mismatch: got $got want $UPSTREAM_PIN"
  exit 1
fi

# Diff ci/upstream copies against the pin.
tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT
git -C upstream show "${UPSTREAM_PIN}:.github/workflows/rust-test-lint.yml" >"$tmp/rust-test-lint.yml"
git -C upstream show "${UPSTREAM_PIN}:.github/workflows/ci.yml" >"$tmp/ci.yml"
diff -u "$tmp/rust-test-lint.yml" ci/upstream/rust-test-lint.yml
diff -u "$tmp/ci.yml" ci/upstream/ci.yml

# Ensure lab workflow run: lines match upstream (allowing listed deviations only).
# Deviation markers that may appear in lab files:
#   working-directory: upstream
#   submodules: true
#   workspaces: upstream
#   full SHA pins for checkout/setup-node
python3 - <<'PY'
from pathlib import Path
import re
import sys

upstream = Path("ci/upstream/rust-test-lint.yml").read_text().splitlines()
lab = Path(".github/workflows/upstream-rust-test-lint.yml").read_text().splitlines()

def run_bodies(lines):
    bodies = []
    i = 0
    while i < len(lines):
        if lines[i].lstrip().startswith("run: |"):
            i += 1
            body = []
            while i < len(lines):
                line = lines[i]
                if line.startswith("          "):
                    body.append(line[10:])
                    i += 1
                    continue
                if line.strip() == "":
                    body.append("")
                    i += 1
                    continue
                break
            bodies.append("\n".join(body).rstrip() + "\n")
            continue
        m = re.match(r"(\s*)run:\s+(.+)$", lines[i])
        if m and not lines[i].rstrip().endswith("|"):
            bodies.append(m.group(2) + "\n")
        i += 1
    return bodies

u_bodies = run_bodies(upstream)
l_bodies = run_bodies(lab)
if len(u_bodies) != len(l_bodies):
    print(f"run: body count differs: upstream={len(u_bodies)} lab={len(l_bodies)}")
    sys.exit(1)
for idx, (u, l) in enumerate(zip(u_bodies, l_bodies)):
    if u != l:
        print(f"run body {idx} differs")
        print("--- upstream")
        print(u)
        print("--- lab")
        print(l)
        sys.exit(1)
print(f"upstream-parity ok ({len(u_bodies)} run bodies)")
PY
